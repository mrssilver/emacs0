//是 Go 中泛型最大堆的几种实现方式：

1. 基本泛型最大堆实现

package main

import "fmt"

// 最大堆结构
type MaxHeap[T comparable] struct {
    items []T
    less  func(a, b T) bool  // 比较函数，用于决定堆的性质
}

// 创建最大堆
func NewMaxHeap[T comparable](less func(a, b T) bool) *MaxHeap[T] {
    return &MaxHeap[T]{
        items: make([]T, 0),
        less:  less,
    }
}

// 堆大小
func (h *MaxHeap[T]) Size() int {
    return len(h.items)
}

// 插入元素
func (h *MaxHeap[T]) Push(item T) {
    h.items = append(h.items, item)
    h.up(len(h.items) - 1)
}

// 弹出最大元素
func (h *MaxHeap[T]) Pop() (T, bool) {
    if len(h.items) == 0 {
        var zero T
        return zero, false
    }
    
    item := h.items[0]
    last := len(h.items) - 1
    h.items[0] = h.items[last]
    h.items = h.items[:last]
    
    if len(h.items) > 0 {
        h.down(0)
    }
    
    return item, true
}

// 查看最大元素
func (h *MaxHeap[T]) Peek() (T, bool) {
    if len(h.items) == 0 {
        var zero T
        return zero, false
    }
    return h.items[0], true
}

// 向上调整
func (h *MaxHeap[T]) up(index int) {
    for {
        parent := (index - 1) / 2
        if index <= 0 || !h.less(h.items[parent], h.items[index]) {
            break
        }
        h.swap(parent, index)
        index = parent
    }
}

// 向下调整
func (h *MaxHeap[T]) down(index int) {
    for {
        left := 2*index + 1
        right := 2*index + 2
        largest := index
        
        if left < len(h.items) && h.less(h.items[largest], h.items[left]) {
            largest = left
        }
        
        if right < len(h.items) && h.less(h.items[largest], h.items[right]) {
            largest = right
        }
        
        if largest == index {
            break
        }
        
        h.swap(index, largest)
        index = largest
    }
}

// 交换元素
func (h *MaxHeap[T]) swap(i, j int) {
    h.items[i], h.items[j] = h.items[j], h.items[i]
}


2. 支持可比较约束的简化版本

package main

import "fmt"

// 可比较类型约束
type Ordered interface {
    ~int | ~int8 | ~int16 | ~int32 | ~int64 |
    ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~uintptr |
    ~float32 | ~float64 |
    ~string
}

// 泛型最大堆
type MaxHeap[T Ordered] struct {
    data []T
}

// 创建最大堆
func NewMaxHeap[T Ordered]() *MaxHeap[T] {
    return &MaxHeap[T]{data: make([]T, 0)}
}

// 从切片构建堆
func NewMaxHeapFromSlice[T Ordered](slice []T) *MaxHeap[T] {
    heap := &MaxHeap[T]{data: slice}
    for i := len(heap.data)/2 - 1; i >= 0; i-- {
        heap.heapify(i)
    }
    return heap
}

// 插入
func (h *MaxHeap[T]) Insert(val T) {
    h.data = append(h.data, val)
    h.siftUp(len(h.data) - 1)
}

// 提取最大值
func (h *MaxHeap[T]) ExtractMax() (T, bool) {
    if len(h.data) == 0 {
        var zero T
        return zero, false
    }
    
    max := h.data[0]
    h.data[0] = h.data[len(h.data)-1]
    h.data = h.data[:len(h.data)-1]
    
    if len(h.data) > 0 {
        h.heapify(0)
    }
    
    return max, true
}

// 堆化
func (h *MaxHeap[T]) heapify(i int) {
    largest := i
    left := 2*i + 1
    right := 2*i + 2
    
    if left < len(h.data) && h.data[left] > h.data[largest] {
        largest = left
    }
    
    if right < len(h.data) && h.data[right] > h.data[largest] {
        largest = right
    }
    
    if largest != i {
        h.data[i], h.data[largest] = h.data[largest], h.data[i]
        h.heapify(largest)
    }
}

// 向上调整
func (h *MaxHeap[T]) siftUp(i int) {
    for i > 0 {
        parent := (i - 1) / 2
        if h.data[i] <= h.data[parent] {
            break
        }
        h.data[i], h.data[parent] = h.data[parent], h.data[i]
        i = parent
    }
}


3. 使用接口的灵活实现

package main

import "fmt"

// 可比较接口
type Comparable[T any] interface {
    CompareTo(other T) int
}

// 自定义类型实现
type Person struct {
    Name string
    Age  int
}

func (p Person) CompareTo(other Person) int {
    if p.Age > other.Age {
        return 1
    } else if p.Age < other.Age {
        return -1
    }
    return 0
}

// 泛型最大堆
type GenericMaxHeap[T Comparable[T]] struct {
    items []T
}

func NewGenericMaxHeap[T Comparable[T]]() *GenericMaxHeap[T] {
    return &GenericMaxHeap[T]{
        items: make([]T, 0),
    }
}

// 插入
func (h *GenericMaxHeap[T]) Insert(item T) {
    h.items = append(h.items, item)
    h.siftUp(len(h.items) - 1)
}

// 提取最大值
func (h *GenericMaxHeap[T]) ExtractMax() (T, bool) {
    if len(h.items) == 0 {
        var zero T
        return zero, false
    }
    
    max := h.items[0]
    h.items[0] = h.items[len(h.items)-1]
    h.items = h.items[:len(h.items)-1]
    
    if len(h.items) > 0 {
        h.heapify(0)
    }
    
    return max, true
}

// 堆化
func (h *GenericMaxHeap[T]) heapify(i int) {
    largest := i
    left := 2*i + 1
    right := 2*i + 2
    
    if left < len(h.items) && h.items[left].CompareTo(h.items[largest]) > 0 {
        largest = left
    }
    
    if right < len(h.items) && h.items[right].CompareTo(h.items[largest]) > 0 {
        largest = right
    }
    
    if largest != i {
        h.items[i], h.items[largest] = h.items[largest], h.items[i]
        h.heapify(largest)
    }
}

// 向上调整
func (h *GenericMaxHeap[T]) siftUp(i int) {
    for i > 0 {
        parent := (i - 1) / 2
        if h.items[i].CompareTo(h.items[parent]) <= 0 {
            break
        }
        h.items[i], h.items[parent] = h.items[parent], h.items[i]
        i = parent
    }
}


4. 使用示例

func main() {
    // 示例1: 基本使用
    heap1 := NewMaxHeap[int](func(a, b int) bool {
        return a < b  // 最大堆：a < b 表示 a 小于 b
    })
    
    heap1.Push(3)
    heap1.Push(1)
    heap1.Push(4)
    heap1.Push(2)
    
    for heap1.Size() > 0 {
        val, _ := heap1.Pop()
        fmt.Print(val, " ")  // 输出: 4 3 2 1
    }
    fmt.Println()
    
    // 示例2: 可比较类型
    heap2 := NewMaxHeapFromSlice([]int{3, 1, 4, 2, 5})
    
    for {
        val, ok := heap2.ExtractMax()
        if !ok {
            break
        }
        fmt.Print(val, " ")  // 输出: 5 4 3 2 1
    }
    fmt.Println()
    
    // 示例3: 自定义类型
    heap3 := NewGenericMaxHeap[Person]()
    heap3.Insert(Person{"Alice", 25})
    heap3.Insert(Person{"Bob", 30})
    heap3.Insert(Person{"Charlie", 20})
    
    for {
        p, ok := heap3.ExtractMax()
        if !ok {
            break
        }
        fmt.Printf("%s(%d) ", p.Name, p.Age)  // 输出: Bob(30) Alice(25) Charlie(20)
    }
    fmt.Println()
}


5. 性能优化版本（固定大小）

type FixedSizeMaxHeap[T Ordered] struct {
    data []T
    size int
    cap  int
}

func NewFixedSizeMaxHeap[T Ordered](capacity int) *FixedSizeMaxHeap[T] {
    return &FixedSizeMaxHeap[T]{
        data: make([]T, capacity),
        cap:  capacity,
    }
}

// 插入，如果堆满则替换最小值
func (h *FixedSizeMaxHeap[T]) Push(val T) {
    if h.size < h.cap {
        h.data[h.size] = val
        h.siftUp(h.size)
        h.size++
    } else if val > h.data[0] { // 只保留最大的 cap 个元素
        h.data[0] = val
        h.heapify(0)
    }
}


要点总结

1. 类型约束：使用泛型约束确保类型可比较

2. 比较函数：通过函数参数或接口实现灵活的比较逻辑

3. 核心操作：

  ◦ Push(): 插入元素，时间复杂度 O(log n)

  ◦ Pop(): 弹出最大值，时间复杂度 O(log n)

  ◦ Peek(): 查看最大值，时间复杂度 O(1)

4. 堆调整：实现 heapify() 和 siftUp() 来维护堆性质

5. 应用场景：优先级队列、Top K 问题、堆排序等

选择哪种实现取决于具体需求：

• 需要简单比较：使用 Ordered 约束

• 需要复杂比较：使用比较函数参数

• 需要类型自定义比较：使用接口实现